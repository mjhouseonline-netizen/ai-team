# AI Team - Environment Variables Configuration
# Copy this file to .env and fill in your actual API keys

# ============================================
# REQUIRED API KEYS
# ============================================

# Anthropic (Claude) - Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (GPT) - Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google (Gemini) - Get your key at: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# ============================================
# STRIPE PAYMENT CONFIGURATION (Optional)
# ============================================

# Stripe API Keys - Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# Stripe Price IDs (for subscription tiers)
# Backward compatibility:
# - STRIPE_STARTER_PRICE_ID is treated as STRIPE_PRO_PRICE_ID if STRIPE_PRO_PRICE_ID is missing.
# - STRIPE_ENTERPRISE_PRICE_ID is treated as STRIPE_TEAM_PRICE_ID if STRIPE_TEAM_PRICE_ID is missing.
STRIPE_PRO_PRICE_ID=your_pro_19_monthly_price_id_here
STRIPE_TEAM_PRICE_ID=your_team_79_monthly_price_id_here
STRIPE_STARTER_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# ============================================
# OPTIONAL: Additional AI Model API Keys
# ============================================

# DeepSeek - Get from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Perplexity - Get from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Grok (xAI) - Get from: https://x.ai/
GROK_API_KEY=your_grok_api_key_here

# OpenRouter - Get from: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Mistral - Get from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here

# ============================================
# APPLICATION CONFIGURATION
# ============================================

# Flask Secret Key (auto-generated if not set)
SECRET_KEY=your_secret_key_here_change_this_in_production

# Comma-separated origins allowed to use cookie-authenticated browser requests
ALLOWED_ORIGINS=https://ai-team.skillsoul.store,http://127.0.0.1:5000,http://localhost:5000

# Admin bootstrap. Set ADMIN_PASSWORD only when creating/resetting the admin user.
ADMIN_EMAIL=bubblesfox@gmail.com
ADMIN_USERNAME=bubblesfox
ADMIN_PASSWORD=
RESET_ADMIN_PASSWORD=false

# Local-only debug toggle. Never set this to 1 in production.
FLASK_DEBUG=0

# ============================================
# SETUP INSTRUCTIONS
# ============================================
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual API keys
# 3. Never commit the .env file to version control
# 4. Restart the application after making changes
# 5. See API_KEYS_SETUP.md for detailed setup instructions
